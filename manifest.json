{
  "manifest_version": 3,
  "name": "Madden Roster Bridge",
  "version": "0.3.0",
  "description": "Courier for the Madden 27 TB Editor: pulls your Team Builder team into the site, delivers the roster you build back with one button, and EA's own Save keeps it.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "debugger"
  ],
  "host_permissions": [
    "https://madden27-tb-editor.com/*",
    "https://www.ea.com/*",
    "https://cdn.mcr.ea.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Madden Roster Bridge"
  },
  "options_page": "diagnostics.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/*madden-nfl/team-builder*"
      ],
      "js": [
        "tb-urls.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://madden27-tb-editor.com/*"
      ],
      "js": [
        "shared/bridge-protocol.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
